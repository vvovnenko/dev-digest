{
  "name": "@devdigest/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:it": "vitest run --project integration",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "arch": "depcruise src ../reviewer-core/src --config .dependency-cruiser.cjs --ignore-known --output-type err-long",
    "arch:baseline": "depcruise-baseline src ../reviewer-core/src --config .dependency-cruiser.cjs",
    "arch:stale": "depcruise-baseline src ../reviewer-core/src --config .dependency-cruiser.cjs --output-to - | diff -u .dependency-cruiser-known-violations.json - || (echo 'Stale baseline: a known violation is gone. Run pnpm arch:baseline and commit the smaller file.' && exit 1)",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.33.1",
    "@ast-grep/napi": "0.43.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@vscode/ripgrep": "^1.15.9",
    "dependency-cruiser": "^17.4.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-sse-v2": "^4.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "fflate": "^0.8.3",
    "graphology": "^0.26.0",
    "graphology-metrics": "^2.4.0",
    "js-tiktoken": "^1.0.21",
    "octokit": "^4.0.3",
    "openai": "^4.77.0",
    "p-queue": "^8.0.1",
    "postgres": "^3.4.5",
    "simple-git": "^3.27.0",
    "yaml": "^2.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.16.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "2.1.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.0.0",
    "testcontainers": "^10.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.8"
  }
}
